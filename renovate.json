{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex", "nix"],
  "nix": { "enabled": true },
  "timezone": "America/Chicago",
  "dependencyDashboard": true,
  "platformCommit": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "baseBranchPatterns": ["main"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "kavita mixes 3- and 4-part tags, which docker versioning wont compare",
      "matchPackageNames": ["docker.io/jvmilazz0/kavita"],
      "versioning": "loose"
    },
    {
      "description": "non-major container bumps ride on CI",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true
    },
    {
      "description": "one branch so the whole lock builds together",
      "matchManagers": ["nix"],
      "groupName": "flake inputs",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "images pinned as tag@digest",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "image = \"(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "images pinned by digest only, so track latest",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "image = \"(?<depName>[a-z0-9./-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker"
    }
  ]
}
