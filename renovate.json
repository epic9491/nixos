{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex", "nix"],
  "nix": { "enabled": true },
  "timezone": "America/Chicago",
  "dependencyDashboard": true,
  "platformCommit": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "baseBranchPatterns": ["main"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Automerge non-major container updates once CI passes",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true
    },
    {
      "description": "Daily grouped flake input bump, automerged into main once CI passes",
      "matchManagers": ["nix"],
      "groupName": "flake inputs",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images pinned as tag@digest in nix files",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "image = \"(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Container images pinned by digest only, tracked against latest",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "image = \"(?<depName>[a-z0-9./-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker"
    }
  ]
}
