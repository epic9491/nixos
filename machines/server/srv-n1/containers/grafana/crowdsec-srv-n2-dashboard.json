    {
      "type": "row",
      "title": "Buckets, LAPI & process",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "Live buckets by scenario",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "h": 6,
            "w": 12,
            "x": 0,
            "y": 52
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (name) (cs_buckets{job=\"crowdsec-srv-n2\"})",
              "legendFormat": "{{name}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "fillOpacity": 10
              }
            }
