          },
          "gridPos": {
            "h": 6,
            "w": 12,
            "x": 12,
            "y": 52
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(cs_lapi_request_duration_seconds_bucket{job=\"crowdsec-srv-n2\"}[$__rate_interval])))",
              "legendFormat": "{{endpoint}}"
            }
          ],
          "fieldConfig": {
