{
  "name": "srv-n2-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "kv_namespaces": [
    {
      "binding": "srv_n2_monitor_state",
      "id": "d7bb019a9f7b429c9165de325da800e0"
    }
  ]
}
